{
  "dashboard": {
    "id": null,
    "uid": "flowmatix-system",
    "title": "Flowmatix System Overview",
    "tags": ["flowmatix", "infrastructure"],
    "timezone": "Europe/Berlin",
    "refresh": "30s",
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "CPU Usage (%)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "{{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 60 },
                { "color": "red", "value": 80 }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "RAM Usage (%)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
            "legendFormat": "{{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 60 },
                { "color": "red", "value": 80 }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Container Restarts",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "increase(container_restart_count[1h])",
            "legendFormat": "{{name}}"
          },
          {
            "expr": "changes(container_last_seen{name=~\".+\"}[5m])",
            "legendFormat": "{{name}} (restarts)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 3 }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "API Response Time (p95)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"flowmatix-api\"}[5m])) by (le))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"flowmatix-api\"}[5m])) by (le))",
            "legendFormat": "p50"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 2 }
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Database Queries / sec",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "rate(pg_stat_database_tup_fetched{datname=\"flowmatix\"}[5m])",
            "legendFormat": "SELECT"
          },
          {
            "expr": "rate(pg_stat_database_tup_inserted{datname=\"flowmatix\"}[5m])",
            "legendFormat": "INSERT"
          },
          {
            "expr": "rate(pg_stat_database_tup_updated{datname=\"flowmatix\"}[5m])",
            "legendFormat": "UPDATE"
          },
          {
            "expr": "rate(pg_stat_database_tup_deleted{datname=\"flowmatix\"}[5m])",
            "legendFormat": "DELETE"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "ops" }
        }
      },
      {
        "id": 6,
        "title": "Active DB Connections",
        "type": "stat",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "pg_stat_activity_count{datname=\"flowmatix\"}",
            "legendFormat": "connections"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 50 },
                { "color": "red", "value": 90 }
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "HTTP Request Rate",
        "type": "stat",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"flowmatix-api\"}[5m]))",
            "legendFormat": "req/s"
          }
        ],
        "fieldConfig": {
          "defaults": { "unit": "reqps" }
        }
      }
    ]
  }
}
